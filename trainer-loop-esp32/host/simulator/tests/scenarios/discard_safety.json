{
  "name": "confirmed discard does not publish a saved ride",
  "steps": [
    {"command":{"op":"setup"}},
    {"command":{"op":"advance","ms":1000}},
    {"command":{"op":"click","text":"DEVICES"}},
    {"command":{"op":"click","text":"Trainer  |  Trainer Loop FTMS\nSignal -38 dBm"}},
    {"command":{"op":"advance","ms":100}},
    {"command":{"op":"click","control_id":"workout-card"}},
    {"command":{"op":"click","text":"START WORKOUT"},"expect":{"ride_state":"Running"}},
    {"command":{"op":"click","text":"PAUSE"},"expect":{"screen":"Paused","ride_state":"Paused"}},
    {"command":{"op":"click","text":"DISCARD RIDE"},"expect":{"screen":"Discard Confirmation","ride_state":"Paused"}},
    {"command":{"op":"click","text":"DISCARD RIDE"},"expect":{"ride_state":"Workout Preview","history":[]}}
  ]
}
