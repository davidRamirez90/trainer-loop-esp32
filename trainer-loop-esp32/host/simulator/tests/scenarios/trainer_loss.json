{
  "name": "trainer loss pauses and reconnect does not resume automatically",
  "steps": [
    {"command":{"op":"setup"}},
    {"command":{"op":"advance","ms":1000}},
    {"command":{"op":"click","text":"DEVICES"}},
    {"command":{"op":"click","text":"Trainer  |  Trainer Loop FTMS\nSignal -38 dBm"}},
    {"command":{"op":"advance","ms":100}},
    {"command":{"op":"click","control_id":"workout-card"}},
    {"command":{"op":"click","text":"START WORKOUT"},"expect":{"ride_state":"Running"}},
    {"command":{"op":"ftms","auto_reconnect":false}},
    {"command":{"op":"device","role":"trainer","available":false}},
    {"command":{"op":"advance","ms":100},"expect":{"ride_state":"Paused","pause_reason":"trainer_disconnected","resistance_unknown":true}},
    {"command":{"op":"device","role":"trainer","available":true}},
    {"command":{"op":"ftms","auto_reconnect":true}},
    {"command":{"op":"advance","ms":1000},"expect":{"ride_state":"Paused","screen":"Paused"}}
  ]
}
