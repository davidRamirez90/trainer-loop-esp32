{
  "name": "rejected FTMS target command pauses without continuing to ride",
  "steps": [
    {"command":{"op":"setup"}},
    {"command":{"op":"advance","ms":1000}},
    {"command":{"op":"click","text":"DEVICES"}},
    {"command":{"op":"click","text":"Trainer  |  Trainer Loop FTMS\nSignal -38 dBm"}},
    {"command":{"op":"advance","ms":100}},
    {"command":{"op":"click","control_id":"workout-card"}},
    {"command":{"op":"click","text":"START WORKOUT"},"expect":{"ride_state":"Running"}},
    {"command":{"op":"ftms","reject":true}},
    {"command":{"op":"advance","ms":100},"expect":{"ride_state":"Paused","pause_reason":"command_failure","resistance_unknown":true}},
    {"command":{"op":"advance","ms":1000},"expect":{"ride_state":"Paused"}}
  ]
}
